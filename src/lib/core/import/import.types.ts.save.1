
/**
 * ==========================================================
 * IMPORT TYPES
 * ==========================================================
 * Shared types for the entire import subsystem.
 *
 * Rules:
 * - No business logic
 * - No external service dependencies
 * - Types only
 * ==========================================================
 */

/* ==========================================================
 * IMPORT SOURCE
 * ========================================================== */

export enum ImportSource {
  AMAZON = "amazon",
  SHOPIFY = "shopify",
  ETSY = "etsy",
  ALIEXPRESS = "aliexpress",
  WOOCOMMERCE = "woocommerce",
  CSV = "csv",
  API = "api",
  MANUAL = "manual",
}

/* ==========================================================
 * IMPORT MODE
 * ========================================================== */

export enum ImportMode {
  FULL = "full",
  INCREMENTAL = "incremental",
  SINGLE = "single",
  BULK = "bulk",
}

/* ==========================================================
 * IMPORT STATUS
 * ========================================================== */

export enum ImportStatus {
  PENDING = "pending",
  RUNNING = "running",
  COMPLETED = "completed",
  FAILED = "failed",
  CANCELLED = "cancelled",
}

/* ==========================================================
 * IMPORT PRIORITY
 * ========================================================== */

export enum ImportPriority {
  LOW = "low",
  NORMAL = "normal",
  HIGH = "high",
  CRITICAL = "critical",
}

/* ==========================================================
 * IMPORT OPTIONS
 * ========================================================== */

export interface ImportOptions {
  /**
   * Validate every product before import.
   * Default: true
   */
  validate?: boolean;

  /**
   * Normalize marketplace data into AdapterProduct.
   * Default: true
   */
  normalize?: boolean;

  /**
   * Skip duplicated products.
   * Default: true
   */
  deduplicate?: boolean;

  /**
   * Overwrite existing products.
   * Default: false
   */
  overwriteExisting?: boolean;

  /**
   * Validate without saving.
   * Default: false
   */
  dryRun?: boolean;

  /**
   * Number of products loaded into one batch.
   *
   * Processing is still ONE product at a time.
   *
   * Default : 100
   * Minimum : 1
   * Maximum : 1000
   *
   * Examples
   * 10
   * 50
   * 100
   * 250
   * 500
   * 1000
   */
  batchSize?: number;
}

/* ==========================================================
 * IMPORT REQUEST
 * ========================================================== */

export interface ImportRequest {
  source: ImportSource;

  mode: ImportMode;

  organizationId: string;

  products: RawProduct[];

  options?: ImportOptions;
}

/* ==========================================================
 * IMPORT CONTEXT
 * ========================================================== */

export interface ImportContext {
  requestId: string;

  organizationId: string;

  userId?: string;

  startedAt: Date;
}

/* ==========================================================
 * IMPORT JOB
 * ========================================================== */

export interface ImportJob {
  id: string;

  status: ImportStatus;

  priority: ImportPriority;

  request: ImportRequest;

  context: ImportContext;
}

/* ==========================================================
 * IMPORT STATISTICS
 * ========================================================== */

export interface ImportStatistics {
  total: number;

  imported: number;

  skipped: number;

  failed: number;

  duplicated: number;
}

/* ==========================================================
 * IMPORT ERROR
 * ========================================================== */

export interface ImportError {
  code: string;

  message: string;

  productId?: string;
}

/* ==========================================================
 * IMPORT RESULT
 * ========================================================== */

export interface ImportResult {
  success: boolean;

  products: AdapterProduct[];

  statistics: ImportStatistics;

  errors: ImportError[];
}

/* ==========================================================
 * IMPORT PROGRESS
 * ========================================================== */

export interface ImportProgress {
  total: number;

  processed: number;

  percentage: number;
}
/* ==========================================================
 * IMPORT → PERSISTENCE REQUEST
 * ==========================================================
 */

export interface ImportPersistenceRequest {

  readonly organizationId: string;

  readonly entity:
    UniversalEntity<AdapterProduct>;

  readonly mode:
    PersistenceMode;

}

/* ==========================================================
 * IMPORT → PERSISTENCE BATCH REQUEST
 * ==========================================================
 */

export interface ImportPersistenceBatchRequest {

  readonly organizationId: string;

  readonly entities:
    readonly UniversalEntity<AdapterProduct>[];

  readonly mode:
    PersistenceMode;

}
export interface ImportQueuePayload {
  organizationId: string;

  source: ImportSource;

  mode: ImportMode;

  products: RawProduct[];

  options?: ImportOptions;
}
