type Product = {
  title: string;

  price: number;
  cost?: number;

  sales?: number;
  sellers?: number;

  trendCurrent?: number;
  trendPast?: number;

  likes?: number;
  shares?: number;
  comments?: number;
};

export function autoImportEngine(products: Product[]) {
  // STEP 1 — filter weak products
  const filtered = products.filter((p) => {
    const sales = p.sales ?? 0;

    const cost = p.cost ?? p.price * 0.6;

    const margin = ((p.price - cost) / p.price) * 100;

    const trendGrowth =
      p.trendPast && p.trendPast > 0
        ? ((p.trendCurrent! - p.trendPast) / p.trendPast) * 100
        : 0;

    return (
      sales >= 300 &&
      margin >= 30 &&
      trendGrowth >= 10
    );
  });

  // STEP 2 — scoring
  const scored = filtered.map((p) => {
    const demand = Math.min(100, (p.sales ?? 0) / 10);

    const competition = Math.min(100, (p.sellers ?? 0) / 5);

    const competitionAdjusted = 100 - competition;

    const cost = p.cost ?? p.price * 0.6;

    const margin =
      ((p.price - cost) / p.price) * 100;

    const viral = Math.min(
      100,
      (
        ((p.likes ?? 0) * 0.5) +
        ((p.shares ?? 0) * 3) +
        ((p.comments ?? 0) * 2)
      ) / 10
    );

    const score =
      demand * 0.35 +
      competitionAdjusted * 0.25 +
      margin * 0.2 +
      viral * 0.2;

    return {
      ...p,
      score: Math.round(score),
    };
  });

  // STEP 3 — rank products
  const sorted = scored.sort(
    (a, b) => b.score - a.score
  );

  const total = sorted.length;

  const top20 = Math.ceil(total * 0.2);

  const next30 = Math.ceil(total * 0.3);

  // STEP 4 — auto import decision
  return sorted.map((p, index) => {
    let decision:
      | "auto-import"
      | "review"
      | "reject";

    if (index < top20) {
      decision = "auto-import";
    } else if (index < top20 + next30) {
      decision = "review";
    } else {
      decision = "reject";
    }

    return {
      ...p,
      decision,
      isWinning:
        decision === "auto-import",
    };
  });
}

