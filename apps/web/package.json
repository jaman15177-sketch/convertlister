{
  "name": "convertlister-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "worker": "node dist/worker.js",
    "watch:worker": "nodemon dist/worker.js",
    "saas": "concurrently -n WEB,WORKER -c blue,green \"npm run dev\" \"npm run worker\"",
    "saas:dev": "concurrently -n WEB,WORKER -c blue,green \"npm run dev\" \"npm run watch:worker\"",
    "build": "next build",
    "build:worker": "tsc",
    "start": "next start"
  },
  "dependencies": {
    "concurrently": "^9.0.1",
    "ioredis": "^5.10.1",
    "next": "^16.2.6",
    "playwright": "^1.60.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.2.6",
    "nodemon": "^3.1.0"
  }
}
