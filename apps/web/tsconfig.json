{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",

    "rootDir": ".",
    "outDir": "dist",

    "strict": false,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "**/*.ts"
  ],

  "exclude": [
    "node_modules",
    ".next",
    "dist"
  ]
}
