{
  "manifest_version": 3,
  "name": "ConvertLister AI",
  "version": "1.0",
  "description": "Auto product extractor for SaaS pipeline",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Extract Product"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
